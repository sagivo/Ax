module examples.db_sqlite;

type Item = {id: i64, name: String};

fn main() -> u64 !{alloc[a], err[db.Error], io[db]} = {
    let pool: db.Pool = db.open_timeout(":memory:", 5000u32);
    db.exec0(pool, "CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT NOT NULL)");
    let mut params: Vec[String] = vec.new(test.alloc);
    params.push("first");
    db.exec(pool, "INSERT INTO items(name) VALUES (?)", params);
    let rows: Vec[Item] = db.query0(pool, test.alloc, "SELECT id, name FROM items ORDER BY id");
    rows.at(0).id as u64
};
