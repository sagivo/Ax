module examples.effects;
export { add, boom, safe };

type DivError = | Zero;

fn add(a: i32, b: i32) -> i32 = a + b;

// `raise` is visible in the interface: the row states what can come out.
fn boom(a: i32) -> i32 !{err[DivError]} = raise Zero;

// `catch` discharges the row, so `safe` is effect-free again.
fn safe(a: i32) -> i32 = catch boom(a) { Zero => 0 };

test "boom is caught" = assert(safe(1) == 0);
