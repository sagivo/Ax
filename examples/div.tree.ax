; Prefix tree (file opens with `(`). Same program as examples/div.ax.
(module examples.div
  (export div DivError)
  (type DivError (or Zero))
  (fn div ((a i32) (b i32)) i32 (! (err DivError))
    (if (== b 0) (raise Zero) (int.div_trunc a b)))
  (fn safe_div ((a i32) (b i32)) i32
    (catch (div a b) (arm Zero 0)))
  (fn attempted ((a i32) (b i32)) (Result i32 DivError)
    (attempt (div a b)))
  (test "div zero raises"
    (block
      (assert (== (safe_div 10 2) 5))
      (assert (== (safe_div 10 0) 0))
      (match (attempt (div 7 0))
        (arm (Err Zero) (assert true))
        (arm _ (fail "expected Zero")))))
)
