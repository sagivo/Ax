//! expect: 25i32
// Sum the odd numbers below 10 by skipping the even ones: 1+3+5+7+9.
module conf.control.while_continue;
fn main() -> i32 !{diverge, err[DivError]} = {
    let mut i = 0;
    let mut sum = 0;
    while i < 10 {
        i = i + 1;
        if int.rem(i, 2) == 0 { continue; };
        sum = sum + i;
    };
    sum
};
