//! expect: 1u64
module conf.db.open_transaction_shutdown;

fn main() -> u64 !{err[db.Error], io[db]} = {
    let pool: db.Pool = db.open(":memory:");
    db.exec0(pool, "CREATE TABLE items (id INTEGER PRIMARY KEY)");
    let tx: db.Tx = db.begin(pool);
    db.tx_exec0(tx, "INSERT INTO items(id) VALUES (1)");
    1u64
};
