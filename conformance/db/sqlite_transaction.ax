//! expect: "[{"id":1,"name":"inside transaction"}]"
module conf.db.sqlite_transaction;
type Item = {id: i64, name: String};
fn main() -> String !{alloc[a], err[db.Error], io[db]} = {
    let pool: db.Pool = db.open(":memory:");
    db.exec0(pool, "CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT NOT NULL)");
    let mut tx: db.Tx = db.begin(pool);
    let mut params: Vec[String] = vec.new(test.alloc);
    params.push("inside transaction");
    db.tx_exec(tx, "INSERT INTO items(name) VALUES (?)", params);
    db.commit(tx);
    let rows: Vec[Item] = db.query0(pool, test.alloc, "SELECT id, name FROM items");
    json.encode(test.alloc, rows)
};
