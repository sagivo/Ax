//! expect: 1245i32
// Go test/sort, Rust sort_by: an explicit comparator over a mutable slice.
module conf.sort.ascending;
fn asc(x: &i32, y: &i32) -> Ordering = i32.cmp(x, y);
fn main() -> i32 !{alloc[a], diverge} = {
    let mut xs: Vec[i32] = vec.new(test.alloc);
    xs.push(5); xs.push(1); xs.push(4); xs.push(2);
    sort(&mut xs, asc);
    xs.at(0) * 1000 + xs.at(1) * 100 + xs.at(2) * 10 + xs.at(3)
};
