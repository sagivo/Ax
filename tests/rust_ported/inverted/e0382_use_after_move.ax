//@ port:      inverted-mechanical
//@ expect:    value: 11i32
// Rust: `let y = x; x.s = 6` is E0382. Ax copies on conflict, then the
// assignment mutates only the original.
module tests.rust_ported.inverted.e0382_use_after_move;
type MyStruct = { s: i32 };
fn main() -> i32 = {
    let mut x = MyStruct { s: 5 };
    let y = x;
    x.s = 6;
    y.s + x.s
};
