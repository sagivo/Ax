// Rust: `&x.0` then `&mut x.0` is E0502. Ax compiles.
module tests.rust_ported.inverted.e0502_field_mut_immut;
type Bar = { a: i32, b: i32 };
fn main() -> i32 = {
    let mut x = Bar { a: 1, b: 2 };
    let p = &x.a;
    let q = &mut x.a;
    x.a + x.b
};
