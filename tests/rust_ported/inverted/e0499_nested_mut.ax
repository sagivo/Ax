// Rust: `&mut foo.bar1.int1` then `&mut foo.bar1` is E0499. Ax compiles.
module tests.rust_ported.inverted.e0499_nested_mut;
type Bar = { int1: i32, int2: i32 };
type Foo = { bar1: Bar, bar2: Bar };
fn main() -> i32 = {
    let mut foo = Foo { bar1: Bar { int1: 1, int2: 2 }, bar2: Bar { int1: 3, int2: 4 } };
    let a = &mut foo.bar1.int1;
    let b = &mut foo.bar1;
    foo.bar1.int1
};
