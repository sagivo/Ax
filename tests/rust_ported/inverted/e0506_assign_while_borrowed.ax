// Rust: `p.x = 5` while `q = &p` is E0506. Ax assigns (copy-on-conflict).
module tests.rust_ported.inverted.e0506_assign_while_borrowed;
type Point = { x: i32, y: i32 };
fn main() -> i32 = {
    let mut p = Point { x: 3, y: 4 };
    let q = &p;
    p.x = 5;
    p.x
};
