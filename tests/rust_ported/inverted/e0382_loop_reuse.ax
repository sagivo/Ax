// Rust: moving a non-Copy value in a loop is E0382. Ax copies each iteration.
module tests.rust_ported.inverted.e0382_loop_reuse;
type R = { x: i32 };
fn sink(v: R) -> i32 = v.x;
fn main() -> i32 = {
    let v = R { x: 4 };
    let mut s: i32 = 0;
    for i in range(0, 2) { s = s + sink(v); };
    s
};
