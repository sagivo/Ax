// Rust: overwrite `p` while `q = &p.y` is E0506. Ax reassigns.
module tests.rust_ported.inverted.e0506_reassign_whole;
type Point = { x: i32, y: i32 };
fn main() -> i32 = {
    let mut p = Point { x: 3, y: 4 };
    let q = &p.y;
    p = Point { x: 5, y: 7 };
    p.x
};
