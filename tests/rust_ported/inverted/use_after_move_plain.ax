// Rust rejects the second `sink(v)`. Ax copies and runs. Cost is reported
// on the heapish two-use case in tests/ownership/copy_on_conflict.ax.
module tests.rust_ported.inverted.use_after_move_plain;
type R = { x: i32 };
fn sink(v: R) -> i32 = v.x;
fn main() -> i32 = {
    let v = R { x: 4 };
    sink(v) + sink(v)
};
