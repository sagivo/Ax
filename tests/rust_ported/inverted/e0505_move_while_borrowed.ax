// Rust: `let y = x` while `r = &x.0` is E0505. Ax copies.
module tests.rust_ported.inverted.e0505_move_while_borrowed;
type Foo = { a: i32, b: i32 };
fn main() -> i32 = {
    let x = Foo { a: 1, b: 2 };
    let r = &x.a;
    let y = x;
    y.a + y.b
};
