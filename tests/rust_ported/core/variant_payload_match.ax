module tests.rust_ported.core.variant_payload_match;
type Message = | Quit | Move { x: i32, y: i32 };
fn value(m: Message) -> i32 = match m { Quit => 0; Move { x, y } => x + y; };
fn main() -> i32 = value(Move { x: 5, y: 6 });
