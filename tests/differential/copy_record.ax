// Rust `R` is Copy (all i32). Ax copies on conflict. Same observable.
module tests.differential.copy_record;
type R = { s: i32 };
fn main() -> i32 = {
    let mut x = R { s: 5 };
    let y = x;
    x.s = 6;
    y.s + x.s
};
