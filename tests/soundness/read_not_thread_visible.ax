//@ id:        T-SND-0005
//@ requires:  R-5.2.3
//@ origin:    authored — [R-5.2.3] premise 5: non-Escape is thread-invisible
//@ upstream:  none
//@ license:   MIT
//@ port:      authored
//@ expect:    error: E0600
// Attack: two `&mut` captures of the same binding across `par`.
// Disjointness (E0600) is the mechanism that stops a Read from being
// observed on another branch.
module tests.soundness.read_not_thread_visible;
fn main() -> i32 = {
    let mut x: i32 = 0;
    par { let a = &mut x; let b = &mut x; };
    0
};
